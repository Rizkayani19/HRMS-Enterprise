# Copy to backend\.env and adjust. With no .env the app runs in development mode on SQLite.

# --- Django ---
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database: sqlite (default) or postgres ---
HRMS_DB_ENGINE=sqlite
HRMS_DB_NAME=hrms_demo
HRMS_DB_USER=postgres
# Required when HRMS_DB_ENGINE=postgres
HRMS_DB_PASSWORD=
HRMS_DB_HOST=127.0.0.1
HRMS_DB_PORT=5432

# --- Organisation ---
HRMS_ORG_NAME=NexGen Holdings Ltd.
HRMS_TIME_ZONE=Asia/Karachi
